apiVersion: k0rdent.mirantis.com/v1beta1
kind: ClusterDeployment
metadata:
  name: aws-hosted-${CLUSTER_NAME_SUFFIX}
  namespace: ${NAMESPACE}
spec:
  template: aws-hosted-cp-1-0-13
  credential: aws-cluster-identity-cred
  config:
    clusterLabels: {}
    clusterAnnotations: {}
    controlPlane:
      instanceType: t3.xlarge
    controlPlaneNumber: 1
    publicIP: false
    region: ${AWS_REGION}
    worker:
      instanceType: t3.xlarge
    workersNumber: 1
    vpcID: vpc-079843537414e7e40
    subnets:
      - availabilityZone: us-east-1c
        id: subnet-05d03b59d3ba0e4bb
        isPublic: true
        zoneType: availability-zone
      - availabilityZone: us-east-1b
        id: subnet-034c5f1d061df71ee
        isPublic: false
      - id: subnet-0433c3c0e317304cf
        isPublic: true
        availabilityZone: us-east-1b
      - id: subnet-08c2b52453d44495c
        isPublic: true
        availabilityZone: us-east-1a
      - id: subnet-0cf614d612a3d9a18
        isPublic: false
        availabilityZone: us-east-1c
      - id: subnet-08e306b4cd4bf6339
        isPublic: false
        availabilityZone: us-east-1a
    instanceType: t3.medium
    securityGroupIDs:
      - sg-0a6f15bbc994a34fd
    managementClusterName: aws-kyle
    rootVolumeSize: 30